# .env.example: a template for your .env file. It contains NO real key.
# Copy it to .env (which git ignores), then put your own key in .env.
# The final runs used claude-sonnet-5-5 (Haiku 5.5 was tried first and missed the over_budget wedding).
# Check current model names on docs.claude.com (Models overview).
ANTHROPIC_API_KEY=your-key-here
MODEL_NAME=claude-sonnet-5-5
